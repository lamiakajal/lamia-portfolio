# ==============================================================================
# Environment Variables Example
# ------------------------------------------------------------------------------
# 1. Copy this file to .env.local for local testing (never commit .env.local).
# 2. For production (Vercel/Hosting), add these in Project Settings -> Environment Variables.
# ==============================================================================

# ---------- Contact Form (src/app/api/contact/route.ts) ----------
RESEND_API_KEY=
CONTACT_TO=lamiakajal@gmail.com
# CONTACT_FROM="Portfolio <contact@lamiakajal.com>"

# ---------- Database (MongoDB Atlas) ----------
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# ---------- Authentication (BetterAuth) ----------
# Any 32+ characters long random string (e.g. mash keyboard or generate via CLI)
BETTER_AUTH_SECRET=

# Local: http://localhost:3000 | Live: https://lamiakajal.com
BETTER_AUTH_URL=http://localhost:3000

# Verified emails that will have Admin access (comma separated)
ADMIN_EMAILS=lamiakajal@gmail.com

# ---------- GitHub OAuth Login ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Google OAuth Login (Optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Cloudinary (Blog Images) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=